# Installed by `difu server add` and `difu server upgrade`; @UID@ and @HOME@ are
# the difu user's.
[Unit]
Description=difu agent service
Documentation=https://github.com/opencx-labs/difu/blob/main/docs/cloud-agents.md
Wants=network-online.target user@@UID@.service
After=network-online.target user@@UID@.service

[Service]
Type=simple
User=difu
WorkingDirectory=@HOME@
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/@UID@/bus
Environment=PATH=@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
# One Claude Code config, lock and temporary files for the service and every sandbox.
Environment=CLAUDE_CONFIG_DIR=@HOME@/.claude
EnvironmentFile=-@HOME@/.config/difu/server.env
ExecStart=/usr/local/bin/difu serve
# Only the service gets SIGTERM: it records which sessions were working and
# stops their agents itself, so they continue after the restart.
KillMode=mixed
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
