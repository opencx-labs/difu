<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>difu uses the camera to scan the pairing QR code shown by difu on your computer or server.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>difu uses Face ID to keep your coding agents and reviews locked when you're away.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>difu connects to computers running difu on your local network.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.difu.ios.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>difu</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
